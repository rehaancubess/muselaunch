# MuseLaunch configuration. Copy to `.env` (never commit `.env`).
# Values left blank fall back to safe local defaults; features whose provider is not
# configured show "not connected" and never return simulated results.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
WORKER_URL=http://localhost:8081

# ---------------------------------------------------------------- data
# firestore = real Firebase project (needs FIREBASE_PROJECT_ID + Application Default Credentials)
# memory    = in-process (only with JOB_DISPATCH=inline; data is lost on restart)
DB_DRIVER=firestore
FIREBASE_PROJECT_ID=
# Path to a service-account JSON for local runs (or run: gcloud auth application-default login)
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------- storage
# local = files under LOCAL_STORAGE_DIR served via signed API URLs; gcs = Firebase Storage bucket
STORAGE_DRIVER=local
STORAGE_BUCKET=
LOCAL_STORAGE_DIR=.data/storage
# Any long random string (used to sign local storage URLs)
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------- auth
# firebase = real sign-in; dev = local-only dev tokens (never in production)
AUTH_MODE=firebase
AUTH_DEV_TOKENS=false
# Web app (public) Firebase config from Firebase console > Project settings > Your apps
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- background jobs
# http = API posts jobs to the local worker; inline = API runs jobs itself; cloudtasks = production
JOB_DISPATCH=http
WORKER_SHARED_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------- Meta Model API
# dev.meta.ai > Dashboard > API keys. Standard mode models only (customer data never uses Contributor mode).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Temporary stand-in while no Meta key can be created: `openai` + OPENAI_API_KEY (below) runs Muse
# Wonder / Muse Spark calls on OpenAI's Responses API, labelled OpenAI everywhere. SAM 3.1, Muse Voice
# Transcribe and Muse Image stay off. Ignored as soon as META_API_KEY is set. Default: off.
META_STAND_IN=off
STAND_IN_MODEL_WONDER=gpt-6.1-sol
STAND_IN_MODEL_SPARK=gpt-6.1-terra

# ---------------------------------------------------------------- Muse Spark Open (open weights on Baseten)
# Meta's open-weights Muse Spark, served by Baseten Model APIs (OpenAI-compatible Chat Completions).
# Baseten dashboard > API keys. Blank = "Not connected": everything stays on Muse Spark, no fallback.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# The hackathon key only works with this exact slug (Baseten's docs show `meta-models/muse-spark-open`).
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# Steps that run on Spark Open when the key is set (comma list; empty = fallback only). Known routes:
# copy.generate, composition.variant_briefs, composition.edit.scoped, composition.edit,
# composition.edit.repair, claims.validate, storyboard.generate, concepts.generate (`pnpm doctor` checks them).
# Default: post copy + hook/audience variant briefs. Add composition.edit.scoped (hook rewrites, Brand
# Guardian fixes) after `pnpm smoke:live baseten` and a few real edits look good; its repair stays on Muse Spark.
SPARK_OPEN_TASKS=copy.generate,composition.variant_briefs
# 1 = when a Muse Spark call is rate-limited, unavailable, times out or runs out of credits, run the same
# request once on Spark Open. Always shown as a step in the agent run and metered under Baseten.
SPARK_OPEN_FALLBACK=1
SPARK_OPEN_TIMEOUT_MS=180000

# ---------------------------------------------------------------- Muse Glimmer (self-hosted)
# OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1 ; llama.cpp: http://127.0.0.1:8080/v1
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=muse-glimmer
GLIMMER_LABEL=RTX 5090 (self-hosted)

# ---------------------------------------------------------------- images
# Muse Image is restricted for operators/users in India (Meta Geographic Use Policy §2.2).
# Keep MUSE_IMAGE_ENABLED=false unless the organisers confirm an approved path.
IMAGE_PROVIDER=openai
MUSE_IMAGE_ENABLED=false
OPERATOR_COUNTRY=IN
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------- optional stock media
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------- safety & billing
GLOBAL_DAILY_SPEND_CEILING_USD=40
WORKSPACE_MONTHLY_SPEND_CEILING_USD=25
SIGNUP_CREDITS=300
# Your Firebase uid(s) for the operator console (Settings → Credits shows it when set)
ADMIN_UIDS=
# Optional short domain for tracked links (defaults to API_PUBLIC_URL)
LINK_PUBLIC_BASE_URL=
TRACE_MODEL_IO=true
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- publishing & outreach (module E)
# Register ${API_PUBLIC_URL}/v1/oauth/<provider>/callback as the redirect URI with each provider.
# Leave a pair blank and that channel uses the export package + manual posting flow (never simulated).
# HMAC key for OAuth state (defaults to a key derived from TOKEN_ENCRYPTION_KEY)
OAUTH_STATE_SECRET=
# Google OAuth client (YouTube Data API v3 + Gmail API enabled). Used for YouTube publishing and Gmail outreach.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta app: Instagram API with Instagram Login (professional accounts)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta app: Facebook Login for Business (Pages video publishing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# TikTok Login Kit + Content Posting API (Direct Post). Set TIKTOK_AUDITED=true only after TikTok's audit (public posts).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
# X developer app, OAuth 2.0 confidential client with Read and write permissions
X_CLIENT_ID=
X_CLIENT_SECRET=
# Outreach anti-blast limits
OUTREACH_DAILY_SEND_LIMIT=20
OUTREACH_MIN_INTERVAL_SEC=60
