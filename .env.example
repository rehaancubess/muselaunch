# MuseLaunch configuration. Copy to `.env` (never commit `.env`).
# Values left blank fall back to safe local defaults; features whose provider is not
# configured show "not connected" and never return simulated results.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
WORKER_URL=http://localhost:8081

# ---------------------------------------------------------------- data
# firestore = real Firebase project (needs FIREBASE_PROJECT_ID + Application Default Credentials)
# memory    = in-process (only with JOB_DISPATCH=inline; data is lost on restart)
DB_DRIVER=firestore
FIREBASE_PROJECT_ID=
# Path to a service-account JSON for local runs (or run: gcloud auth application-default login)
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------- storage
# local = files under LOCAL_STORAGE_DIR served via signed API URLs; gcs = Firebase Storage bucket
STORAGE_DRIVER=local
STORAGE_BUCKET=
LOCAL_STORAGE_DIR=.data/storage
# Any long random string (used to sign local storage URLs)
STORAGE_SIGNING_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------- auth
# firebase = real sign-in; dev = local-only dev tokens (never in production)
AUTH_MODE=firebase
AUTH_DEV_TOKENS=false
# Web app (public) Firebase config from Firebase console > Project settings > Your apps
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- background jobs
# http = API posts jobs to the local worker; inline = API runs jobs itself; cloudtasks = production
JOB_DISPATCH=http
WORKER_SHARED_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------- Meta Model API
# dev.meta.ai > Dashboard > API keys. Standard mode models only (customer data never uses Contributor mode).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# ---------------------------------------------------------------- Muse Glimmer (self-hosted)
# OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1 ; llama.cpp: http://127.0.0.1:8080/v1
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=muse-glimmer
GLIMMER_LABEL=RTX 5090 (self-hosted)

# ---------------------------------------------------------------- images
# Muse Image is restricted for operators/users in India (Meta Geographic Use Policy §2.2).
# Keep MUSE_IMAGE_ENABLED=false unless the organisers confirm an approved path.
IMAGE_PROVIDER=openai
MUSE_IMAGE_ENABLED=false
OPERATOR_COUNTRY=IN
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------- optional stock media
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------- safety & billing
GLOBAL_DAILY_SPEND_CEILING_USD=40
WORKSPACE_MONTHLY_SPEND_CEILING_USD=25
SIGNUP_CREDITS=300
TRACE_MODEL_IO=true
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=
