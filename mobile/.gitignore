# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase config for Android push (kept on your PC; uploaded to EAS Build through .easignore)
google-services.json
GoogleService-Info.plist
# Jest
coverage/

# Firebase service-account keys (FCM push): upload them with eas credentials, never commit or upload them
*firebase-adminsdk*.json
service-account*.json
